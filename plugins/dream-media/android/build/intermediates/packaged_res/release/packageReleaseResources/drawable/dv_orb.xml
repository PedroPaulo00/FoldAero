<?xml version="1.0" encoding="utf-8"?>
<!-- Orbe azul brilhante (botão principal, 64dp) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="40dp" android:centerX="0.5" android:centerY="0.32"
                android:startColor="#A8E4FF" android:centerColor="#2A8EE0" android:endColor="#0A4A96" />
            <stroke android:width="1dp" android:color="#0B3F7D" />
        </shape>
    </item>
    <item android:left="9dp" android:right="9dp" android:top="3dp" android:bottom="31dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#D9FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>