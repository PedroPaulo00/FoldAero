<?xml version="1.0" encoding="utf-8"?>
<!-- Orbe azul pequeno (voltar, 40dp) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="26dp" android:centerX="0.5" android:centerY="0.32"
                android:startColor="#9FE2FF" android:centerColor="#1F86D6" android:endColor="#062F66" />
            <stroke android:width="1dp" android:color="#0B3F7D" />
        </shape>
    </item>
    <item android:left="6dp" android:right="6dp" android:top="2dp" android:bottom="19dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#C0FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>