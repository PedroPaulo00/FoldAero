<?xml version="1.0" encoding="utf-8"?>
<!-- Player do dreamview.exe: vídeo + barras de vidro no estilo do Windows Media Player -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/dv_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Toques na área do vídeo mostram/escondem os controles -->
    <View
        android:id="@+id/dv_touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/dv_center"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_gravity="center"
        android:background="@drawable/dv_orb_big"
        android:contentDescription="Reproduzir"
        android:elevation="6dp"
        android:paddingStart="6dp"
        android:scaleType="center"
        android:src="@drawable/dv_ic_play_big"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/dv_buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#8FD2FF"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dv_top"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="top"
        android:background="@drawable/dv_glass_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/dv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dv_orb_small"
            android:contentDescription="Voltar"
            android:elevation="3dp"
            android:scaleType="center"
            android:src="@drawable/dv_ic_back" />

        <TextView
            android:id="@+id/dv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:shadowColor="#CC000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dv_bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/dv_glass_bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dv_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:text="0:00"
                android:textColor="#DDEEFF"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/dv_seek"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progressDrawable="@drawable/dv_seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/dv_seek_thumb" />

            <TextView
                android:id="@+id/dv_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="44dp"
                android:text="0:00"
                android:textColor="#DDEEFF"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/dv_mute"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/dv_btn_round"
                android:contentDescription="Som"
                android:scaleType="center"
                android:src="@drawable/dv_ic_volume" />

            <!-- Cápsula central: voltar 10s, tocar/pausar (orbe), avançar 10s -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/dv_pill"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageButton
                    android:id="@+id/dv_rew"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:background="@drawable/dv_btn_flat"
                    android:contentDescription="Voltar 10 segundos"
                    android:scaleType="center"
                    android:src="@drawable/dv_ic_rew" />

                <ImageButton
                    android:id="@+id/dv_play"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/dv_orb"
                    android:contentDescription="Tocar ou pausar"
                    android:elevation="4dp"
                    android:scaleType="center"
                    android:src="@drawable/dv_ic_pause" />

                <ImageButton
                    android:id="@+id/dv_fwd"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:background="@drawable/dv_btn_flat"
                    android:contentDescription="Avançar 10 segundos"
                    android:scaleType="center"
                    android:src="@drawable/dv_ic_fwd" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/dv_repeat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end|center_vertical"
                android:alpha="0.45"
                android:background="@drawable/dv_btn_round"
                android:contentDescription="Repetir"
                android:scaleType="center"
                android:src="@drawable/dv_ic_repeat" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
