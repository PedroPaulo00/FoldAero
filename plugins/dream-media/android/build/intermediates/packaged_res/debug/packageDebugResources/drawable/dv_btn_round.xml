<?xml version="1.0" encoding="utf-8"?>
<!-- Botão redondo secundário (som, repetir); acende ao tocar -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#663D9BF0" android:endColor="#331A76C9" />
            <stroke android:width="1dp" android:color="#994CB0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#22FFFFFF" android:endColor="#05FFFFFF" />
            <stroke android:width="1dp" android:color="#AA000000" />
        </shape>
    </item>
</selector>