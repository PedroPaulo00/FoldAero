<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superior de vidro escuro (Aero / Vista Black) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><gradient android:angle="270" android:startColor="#E6474C55" android:centerColor="#F0202226" android:endColor="#F5070708" /></shape>
    </item>
    <item android:bottom="0dp" android:gravity="bottom" android:height="1dp">
        <shape><solid android:color="#40FFFFFF" /></shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape><solid android:color="#30FFFFFF" /></shape>
    </item>
</layer-list>