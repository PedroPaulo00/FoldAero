<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de progresso de vidro: trilho escuro, carregado claro, tocado em azul brilhante -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal" android:height="6dp">
        <shape>
            <corners android:radius="3dp" />
            <solid android:color="#AA000000" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical|fill_horizontal" android:height="6dp">
        <scale android:scaleWidth="100%">
            <shape><corners android:radius="3dp" /><solid android:color="#40FFFFFF" /></shape>
        </scale>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal" android:height="6dp">
        <scale android:scaleWidth="100%">
            <shape>
                <corners android:radius="3dp" />
                <gradient android:angle="270" android:startColor="#BFE6FF" android:centerColor="#3A9BE8" android:endColor="#0A4F9E" />
            </shape>
        </scale>
    </item>
</layer-list>