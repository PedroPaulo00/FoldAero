<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="20dp" android:height="20dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="12dp" android:centerX="0.5" android:centerY="0.3"
                android:startColor="#FFFFFF" android:centerColor="#8FD2FF" android:endColor="#1F86D6" />
            <stroke android:width="1dp" android:color="#0B3F7D" />
        </shape>
    </item>
</layer-list>